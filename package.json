{
  "name": "go-module-manager",
  "displayName": "GMM — Go Module Manager",
  "description": "See and move the Go dependencies of a workspace without touching code you did not ask for.",
  "version": "0.1.6",
  "publisher": "mihaimyh",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/mihaimyh/go-module-manager.git"
  },
  "homepage": "https://github.com/mihaimyh/go-module-manager#readme",
  "bugs": {
    "url": "https://github.com/mihaimyh/go-module-manager/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "go",
    "golang",
    "modules",
    "dependencies",
    "go.mod"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "configuration": {
      "title": "GMM",
      "properties": {
        "gmm.goPath": {
          "type": "string",
          "default": "go",
          "description": "Path to the go executable. Set this when go is not on PATH."
        }
      }
    },
    "commands": [
      {
        "command": "gmm.openPanel",
        "title": "GMM: Open Go Module Manager",
        "icon": "$(extensions)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "gmm.openPanel",
          "when": "resourceFilename == go.mod && resourceScheme == file",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "gmm.openPanel",
          "when": "view == workbench.explorer.fileView",
          "group": "navigation@9"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "harness": "npm run build && node scripts/harness.mjs",
    "package": "npm run typecheck && npm run build && vsce package --no-dependencies",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
